<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	Parent POM for Spring Boot applications.
	This provides dependency management and plugin configuration for Spring Boot projects.
	It automatically manages versions for common dependencies, making the pom cleaner.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version> <!-- Specify a stable Spring Boot version -->
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!-- Project coordinates -->
	<groupId>com.example.sms</groupId>
	<artifactId>student-management-system</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Student Management System</name>
	<description>A student CRUD application with search, pagination, and grade tracking using Spring Boot and Thymeleaf.</description>

	<!-- Project properties -->
	<properties>
		<java.version>17</java.version> <!-- Specify the Java version to be used -->
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
	</properties>

	<!--
	Dependencies section.
	This defines all the libraries and frameworks required by the project.
	Spring Boot starters simplify dependency management by bundling common dependencies.
	-->
	<dependencies>
		<!-- Spring Boot Web Starter: Includes Tomcat and Spring MVC for building web applications -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Boot Data JPA Starter: For persistence with Spring Data JPA and Hibernate -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Thymeleaf Starter: For server-side templating with Thymeleaf -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- H2 Database: An in-memory database, excellent for development and testing -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope> <!-- Only needed at runtime -->
		</dependency>

		<!-- Lombok: A library to reduce boilerplate code (e.g., getters, setters, constructors) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional> <!-- Optional dependency, primarily for compile-time annotation processing -->
		</dependency>

		<!-- Spring Boot DevTools: Provides useful development-time features like automatic restarts -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope> <!-- Only needed at runtime during development -->
			<optional>true</optional>
		</dependency>

		<!-- Spring Boot Starter Test: For unit and integration testing with Spring Boot -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope> <!-- Only needed for testing -->
		</dependency>

		<!--
		Spring Boot Validation Starter: Provides support for Java Bean Validation (JSR 380)
		This is useful for validating form inputs in the web layer.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

	</dependencies>

	<!--
	Build configuration section.
	This defines how the project is built, including plugins and their configurations.
	-->
	<build>
		<plugins>
			<!-- Spring Boot Maven Plugin: Packages the application into an executable JAR/WAR -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Exclude Lombok from the final JAR if it's only used for annotation processing -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>