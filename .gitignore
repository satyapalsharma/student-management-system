# .gitignore for a Java Spring Boot Project

# Compiled class files
*.class

# Package Files
#
# Compiled output files
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Log Files
*.log
logs/
*.trace

# JVM crash logs
hs_err_pid*.log

# Maven
#
# Maven target directory
target/
# Maven pom.xml backup files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# Gradle (if used, though project context specifies Maven)
.gradle/
build/

# IDE specific files
#
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse
.project
.classpath
.settings/
.sts4-cache/
.factorypath

# VS Code
.vscode/

# Operating System Files
#
# macOS
.DS_Store
.localized

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Vim
*.swp
*.swo
*.swn

# Emacs
*~
\#*#

# Spring Boot specific
#
# H2 Database files (if file-based, e.g., jdbc:h2:file:./data/smsdb)
# The project uses H2, so this is important.
*.mv.db
*.trace.db
data/ # Common directory for local database files

# Temporary files
tmp/
temp/

# Configuration files that might contain sensitive information or local overrides
#
# It's common to have local-only configuration files that should not be committed.
# For example, application-dev.properties or application-local.properties
# that contain local database credentials or API keys.
# application.properties itself is usually committed, but specific profiles might not be.
# Uncomment and adjust if you have such files.
# application-dev.properties
# application-local.properties
# application-test.properties
# *.env
# .env

# Other common files to ignore
#
# Any files generated by testing frameworks or build tools that are not part of the source code.
# For example, Surefire reports
# surefire-reports/

# Frontend build artifacts (if a separate frontend build process was integrated)
# node_modules/
# dist/
# build/